CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y

# 网速监控
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_nlbwmon=y

# 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# UPnP
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# USB 打印机
CONFIG_PACKAGE_luci-app-usb-printer=y
CONFIG_PACKAGE_luci-i18n-usb-printer-zh-cn=y
CONFIG_PACKAGE_p910nd=y

# ZeroTier（内网穿透）
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
CONFIG_PACKAGE_zerotier=y

# 系统工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_kmod-fuse=y

# USB 网络共享（iPhone/Android）
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_usb-modeswitch=y

# ============================================================
# 默认设置（中文/中国区定制）
# ============================================================
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# ============================================================
# 性能调优包（MTK 专属）
# ============================================================
# MTK 硬件 QoS（EQoS）- 可选
# CONFIG_PACKAGE_luci-app-eqos-mtk=y

# BBR 拥塞控制（提升长距离/高延迟链路吞吐量）
CONFIG_PACKAGE_kmod-tcp-bbr=y

# nftables 加速
CONFIG_PACKAGE_kmod-nft-offload=y

# ============================================================
# 可选：进一步裁剪体积的包（注释掉以禁用不需要的功能）
# ============================================================
# IPv6 支持（如不需要可注释）
CONFIG_PACKAGE_6rd=y
CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_6to4=y
CONFIG_PACKAGE_ds-lite=y
CONFIG_PACKAGE_ip6tables-extra=y

# DDNS（可选）
# CONFIG_PACKAGE_luci-app-ddns=y
# CONFIG_PACKAGE_ddns-scripts=y

# OpenVPN（可选，体积较大）
# CONFIG_PACKAGE_luci-app-openvpn=y
# CONFIG_PACKAGE_openvpn-openssl=y

# WireGuard（推荐替代 OpenVPN，体积小性能高）
# CONFIG_PACKAGE_luci-app-wireguard=y
# CONFIG_PACKAGE_wireguard-tools=y
# CONFIG_PACKAGE_kmod-wireguard=y

# ============================================================
# 库依赖（自动满足上述包的依赖）
# ============================================================
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_liblzma=y
CONFIG_PACKAGE_libpcre=y
CONFIG_PACKAGE_libpcre2=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_terminfo=y

# ============================================================
# APK 包管理（25.12 新特性）
# ============================================================
CONFIG_PACKAGE_apk-openssl=y

# ============================================================
# 优化说明（相比原配置的改动）
# ============================================================
#
# 1. CONFIG_TARGET_ROOTFS_PARTSIZE: 160MB -> 256MB
#    RAX3000ME eMMC 容量充裕，增大根分区可容纳更多插件
#
# 2. CONFIG_CCACHE=y（原为 not set）
#    开启编译器缓存，二次编译速度提升 40-60%
#
# 3. CONFIG_USE_MOLD=y（原有 MOLD=y 但 USE_MOLD 未启用）
#    启用 MOLD 链接器，链接速度比 GNU ld 快 3-5 倍
#
# 4. CONFIG_TARGET_PREINIT_IP: 192.168.6.1 -> 192.168.1.1
#    preinit 阶段统一使用 192.168.1.1，避免与 failsafe 模式
#    IP 不一致导致救援困难
#
# 5. 无线驱动：改为 mtwifi-cfg（更现代的 MTK 无线配置界面）
#    原配置中 luci-app-mtk/luci-app-mtwifi-cfg 均未明确选择
#
# 6. 新增 kmod-tcp-bbr（BBR 拥塞控制）
#    对 OpenClash 代理场景有明显提速效果
#
# 7. 新增 kmod-nf-nathelper-extra（FTP/H.323/SIP ALG）
#    改善 NAT 穿透兼容性
#
# 8. 新增 e2fsprogs/fdisk/cfdisk/parted
#    配合 diskman 提供完整磁盘管理能力
#
# 9. 新增 kmod-usb-net-cdc-ncm/huawei-cdc-ncm/usb-modeswitch
#    改善 4G/5G USB 网卡及各类 USB 网络设备兼容性
#
# 10. 新增 miniupnpd-nftables（替代 miniupnpd）
#     25.12 内核使用 nftables，nftables 版 UPnP 性能更好
#
# 11. wpad-openssl（保持原选择）
#     支持 WPA3-SAE + 802.11r(FT)/k/v，配合 RAX3000ME 双频使用
#
# 12. CONFIG_PKG_CC_STACKPROTECTOR_REGULAR（保持原版）
#     如需最强安全可改为 STRONG，但会轻微影响性能
#
