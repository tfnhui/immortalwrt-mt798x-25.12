#
# ImmortalWrt 25.12 - CMCC RAX3000ME 优化配置
# 设备: CMCC RAX3000ME (eMMC)
# SoC: MediaTek MT7981B (Filogic 820)
# 内核: Linux 6.12
# 优化说明见文件末尾注释
#

# ============================================================
# 目标平台
# ============================================================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cmcc_rax3000me=y

CONFIG_TARGET_BOARD="mediatek"
CONFIG_TARGET_SUBTARGET="filogic"
CONFIG_TARGET_PROFILE="DEVICE_cmcc_rax3000me"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_LINUX_6_12=y

# ============================================================
# 固件镜像设置
# ============================================================
# initramfs（用于救援/恢复）
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y

# 主根文件系统：squashfs
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 块大小256KB（最佳压缩/解压速度平衡）
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_SQUASHFS_BLOCK_READERS=4
CONFIG_TARGET_SQUASHFS_SMALL_READERS=4

# 分区大小：160MB（原版），可视固件实际体积调整
# RAX3000ME eMMC 容量充足，可适当加大至 256MB 或以上
CONFIG_TARGET_ROOTFS_PARTSIZE=256

# ============================================================
# 编译工具链
# ============================================================
CONFIG_NEED_TOOLCHAIN=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_LIBC_USE_MUSL=y
CONFIG_USE_MUSL=y
CONFIG_MUSL_DISABLE_CRYPT_SIZE_HACK=y

# GCC 14（25.12 默认）
CONFIG_GCC_USE_VERSION_14=y

# Binutils 2.44
CONFIG_BINUTILS_USE_VERSION_2_44=y

# 启用 ccache 加速二次编译（强烈建议开启！原配置关闭了此项）
# 注意：workflow 中也需要配置 CCACHE_DIR
CONFIG_CCACHE=y

# LLVM/BPF 工具链（OpenClash/eBPF 需要）
CONFIG_BPF_TOOLCHAIN_BUILD_LLVM=y
CONFIG_HAS_BPF_TOOLCHAIN=y

# ============================================================
# 优化选项
# ============================================================
# 针对 Cortex-A53 的优化
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
CONFIG_DEFAULT_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a53"
# 额外优化标志（减少函数调用开销）
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt"

# 启用 MOLD 链接器（比 ld 快 3-5x，原配置虽然有 CONFIG_MOLD=y 但未启用 USE_MOLD）
CONFIG_MOLD=y
CONFIG_USE_MOLD=y

# 内核优化为性能（嵌入式路由器更适合性能优化）
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y

# 使用 sstrip 精简二进制（减小固件体积）
CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y

# ============================================================
# 安全加固（保留原配置合理项）
# ============================================================
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_PKG_FORTIFY_SOURCE_2=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_PKG_DT_RELR=y
CONFIG_USE_SECCOMP=y
CONFIG_SHADOW_PASSWORDS=y

# ============================================================
# 全局编译设置
# ============================================================
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
# 使用 APK 包管理（25.12 特性）
CONFIG_USE_APK=y
CONFIG_IPV6=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_DEVEL=y
CONFIG_AUTOREBUILD=y
CONFIG_AUTOREMOVE=y
CONFIG_INCLUDE_CONFIG=y

# 内核 cgroup/namespace（容器支持、OpenClash 需要）
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_FREEZER=y
CONFIG_KERNEL_CGROUP_FREEZER=y
CONFIG_KERNEL_CGROUP_DEVICE=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_RDMA=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_MEMCG_KMEM=y
CONFIG_KERNEL_CGROUP_SCHED=y
CONFIG_KERNEL_FAIR_GROUP_SCHED=y
CONFIG_KERNEL_RT_GROUP_SCHED=y
CONFIG_KERNEL_BLK_CGROUP=y
CONFIG_KERNEL_NET_CLS_CGROUP=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_UTS_NS=y
CONFIG_KERNEL_IPC_NS=y
CONFIG_KERNEL_USER_NS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_NET_NS=y

# 内核网络（IPv4/IPv6 路由多播等）
CONFIG_KERNEL_IPV6=y
CONFIG_KERNEL_IPV6_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_SUBTREES=y
CONFIG_KERNEL_IPV6_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE_MULTIPLE_TABLES=y
CONFIG_KERNEL_IPV6_PIMSM_V2=y
CONFIG_KERNEL_IPV6_SEG6_LWTUNNEL=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IP_MROUTE_MULTIPLE_TABLES=y
CONFIG_KERNEL_IP_PIMSM_V1=y
CONFIG_KERNEL_IP_PIMSM_V2=y
CONFIG_KERNEL_MPTCP=y
CONFIG_KERNEL_MPTCP_IPV6=y
CONFIG_KERNEL_NET_L3_MASTER_DEV=y
CONFIG_KERNEL_NF_CONNTRACK_TIMEOUT=y

# 内核其他
CONFIG_KERNEL_AIO=y
CONFIG_KERNEL_IO_URING=y
CONFIG_KERNEL_FHANDLE=y
CONFIG_KERNEL_FANOTIFY=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_PRINTK=y
CONFIG_KERNEL_PRINTK_TIME=y
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_DEBUG_KERNEL=y
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=y
CONFIG_KERNEL_FRAME_WARN=2048
CONFIG_KERNEL_MAGIC_SYSRQ=y
CONFIG_KERNEL_COREDUMP=y
CONFIG_KERNEL_ELF_CORE=y
CONFIG_KERNEL_DEVMEM=y
CONFIG_KERNEL_SECCOMP_FILTER=y
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_POSIX_MQUEUE=y
CONFIG_KERNEL_SQUASHFS_FRAGMENT_CACHE_SIZE=3
CONFIG_USE_FS_ACL_ATTR=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_F2FS_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_TMPFS_POSIX_ACL=y
CONFIG_KERNEL_EROFS_FS_XATTR=y
CONFIG_KERNEL_EROFS_FS_POSIX_ACL=y
CONFIG_KERNEL_EROFS_FS_SECURITY=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_KERNEL_F2FS_FS_SECURITY=y

# ============================================================
# 平台硬件特性
# ============================================================
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_HAS_FPU=y
CONFIG_HAS_DT_OVERLAY_SUPPORT=y
CONFIG_GPIO_SUPPORT=y
CONFIG_PCI_SUPPORT=y
CONFIG_PCIE_SUPPORT=y
CONFIG_PINCTRL_SUPPORT=y
CONFIG_PWM_SUPPORT=y
CONFIG_USB_SUPPORT=y
CONFIG_RTC_SUPPORT=y
CONFIG_USES_PM=y
CONFIG_USES_DEVICETREE=y
CONFIG_USES_INITRAMFS=y
CONFIG_USES_SEPARATE_INITRAMFS=y
CONFIG_USES_SQUASHFS=y
CONFIG_EMMC_SUPPORT=y
CONFIG_NAND_SUPPORT=y
CONFIG_ARCH_64BIT=y
CONFIG_USES_ROOTFS_PART=y
CONFIG_aarch64=y
CONFIG_ARCH="aarch64"

# ============================================================
# 预启动/启动参数（重要：修正默认 IP）
# ============================================================
CONFIG_TARGET_PREINIT_SUPPRESS_STDERR=y
CONFIG_TARGET_PREINIT_TIMEOUT=4
# 修正：原配置 preinit IP 为 192.168.6.1，与常见局域网段冲突
# 建议改为 192.168.1.1（OpenWrt 标准默认）
CONFIG_TARGET_PREINIT_IP="192.168.1.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.1.255"
CONFIG_TARGET_INIT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
CONFIG_TARGET_INIT_CMD="/sbin/init"
CONFIG_TARGET_INIT_SUPPRESS_STDERR=y

# ============================================================
# Feeds
# ============================================================
CONFIG_PER_FEED_REPO=y
CONFIG_FEED_packages=y
CONFIG_FEED_luci=y
CONFIG_FEED_routing=y
CONFIG_FEED_telephony=y
CONFIG_FEED_video=y

# ============================================================
# 基础系统包
# ============================================================
CONFIG_PACKAGE_apk-openssl=y
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_bridger=y
CONFIG_PACKAGE_busybox=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dnsmasq-full=y
# 禁用 dnsmasq 基础版（与 full 冲突）
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y

# ============================================================
# 无线驱动（RAX3000ME 关键！）
# ============================================================
# 使用 wpad-openssl（支持 WPA3 + 802.11r/k/v，比 wpad-basic 功能完整）
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set

# MTK WiFi 原生驱动（mtwifi-cfg 为新一代配置界面，推荐）
CONFIG_PACKAGE_mtwifi-cfg=y
CONFIG_PACKAGE_lua-cjson=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
# 若要使用 LuCI 标准无线界面，改用以下配置并注释上面4行：
# CONFIG_PACKAGE_luci-app-mtk=y
# CONFIG_PACKAGE_luci-i18n-mtk-zh-cn=y
# CONFIG_PACKAGE_wifi-profile=y
# CONFIG_WIFI_NORMAL_SETTING=y

# ============================================================
# MTK 硬件加速（HNAT/以太网加速）
# ============================================================
CONFIG_PACKAGE_autocore=y
CONFIG_DEFAULT_autocore=y
# HNAT 检测工具
CONFIG_PACKAGE_hnat-detect=y
# 硬件加密加速
CONFIG_PACKAGE_kmod-crypto-hw-safexcel=y
# NFT 硬件 offload
CONFIG_PACKAGE_kmod-nft-offload=y
# NAT helper
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
# MTK SMP 优化
CONFIG_PACKAGE_mtk-smp=y
# L1 工具
CONFIG_PACKAGE_l1util=y

# ============================================================
# eMMC/存储相关（RAX3000ME 必须）
# ============================================================
CONFIG_PACKAGE_automount=y
CONFIG_DEFAULT_automount=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_DEFAULT_f2fsck=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_DEFAULT_mkf2fs=y
CONFIG_PACKAGE_fitblk=y
CONFIG_DEFAULT_fitblk=y
# losetup（loop 设备支持，OpenClash 需要）
CONFIG_PACKAGE_losetup=y
# e2fsprogs（ext4 检查修复）
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
# kmod
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y

# ============================================================
# SSL/TLS（libustream-openssl 优于 mbedtls/wolfssl）
# ============================================================
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_DEFAULT_libustream-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_openssl-util=y
# CONFIG_PACKAGE_libustream-mbedtls is not set
# CONFIG_PACKAGE_libustream-wolfssl is not set

# ============================================================
# LuCI Web 界面
# ============================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# Argon 主题（美观现代）
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# ============================================================
# OpenClash（透明代理）
# ============================================================
CONFIG_PACKAGE_luci-app-openclash=y
# OpenClash 依赖
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_dnsmasq-full=y
# ip6tables（IPv6 透明代理）
CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_kmod-ip6tables=y
# curl（OpenClash 订阅更新需要）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y

# ============================================================
# 磁盘管理
# ============================================================
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_mount-utils=y

# ============================================================
# SMB 文件共享（ksmbd 内核态，性能优于 samba4）
# ============================================================
